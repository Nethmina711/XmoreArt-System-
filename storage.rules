rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public media (portfolio, web assets)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Customer uploaded files with quotes
    match /enquiries/{enquiryId}/{fileName} {
      allow write: if true; // Public upload with quote request
      allow read: if request.auth != null; // Only staff can read
    }

    // Private Project & Client files
    match /projects/{projectId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Quotation PDF documents
    match /quotations/{quotationId}/{fileName} {
      allow read, write: if request.auth != null;
    }

  }
}
