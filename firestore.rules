rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper functions for roles
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isSuperAdmin() {
      return hasRole('SUPER_ADMIN');
    }

    function isManager() {
      return isSuperAdmin() || hasRole('MANAGER');
    }

    function isStaff() {
      return isAuthenticated();
    }

    // 1. Public Content (Services, Portfolio, Packages, Blog, Website Content)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isManager();
    }

    match /portfolio/{projectId} {
      allow read: if resource.data.published == true || isStaff();
      allow write: if isStaff();
    }

    match /packages/{packageId} {
      allow read: if resource.data.published == true || isManager();
      allow write: if isManager();
    }

    match /blogPosts/{postId} {
      allow read: if resource.data.published == true || isStaff();
      allow write: if isStaff();
    }

    match /websiteContent/{docId} {
      allow read: if true;
      allow write: if isManager();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 2. Customer Enquiries & Public Leads (Public can create, Staff can read/update)
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // 3. Customer CRM Data (Protected)
    match /customers/{customerId} {
      allow read, write: if isManager();
    }

    // 4. Quotations & Invoices (Protected)
    match /quotations/{quotationId} {
      allow read, write: if isManager();
    }

    // 5. Orders & Projects (Staff access)
    match /orders/{orderId} {
      allow read, write: if isManager();
    }

    match /projects/{projectId} {
      allow read, write: if isStaff();
    }

    match /tasks/{taskId} {
      allow read, write: if isStaff();
    }

    // 6. Financial Data: Payments & Expenses (Strict Protection)
    match /payments/{paymentId} {
      allow read, write: if isManager();
    }

    match /expenses/{expenseId} {
      allow read, write: if isManager();
    }

    // 7. Team & Staff Profiles
    match /users/{userId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin() || request.auth.uid == userId;
    }

    match /employees/{employeeId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // 8. Notifications & Activity Logs
    match /notifications/{notifId} {
      allow read, write: if isStaff();
    }

    match /activityLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isSuperAdmin();
    }

  }
}
